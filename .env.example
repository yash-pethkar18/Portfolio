# Public site URL (used for metadata, sitemap, Open Graph). Set to your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form email delivery via Resend (https://resend.com). Server-side only.
RESEND_API_KEY=
# Where contact messages are delivered
CONTACT_TO_EMAIL=yashpethkar77@gmail.com
# Verified sender. For testing, Resend allows: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
